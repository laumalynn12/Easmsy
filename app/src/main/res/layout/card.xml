<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/elevation_card_raised"
    app:cardBackgroundColor="@color/card_attention">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_medium">

        <TextView
            android:id="@+id/card_title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            tools:text="@string/tip_critical_package_required" />

        <TextView
            android:id="@+id/card_text"
            style="@style/TextAppearance.AppCompat.Body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_title"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="@dimen/margin_small"
            tools:text="@string/tip_critical_package_message" />

        <Button
            android:id="@+id/card_button_start"
            style="@style/Base.TextAppearance.AppCompat.Widget.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_text"
            android:layout_alignParentStart="true"
            android:background="@android:color/transparent"
            android:minWidth="0px"
            android:textColor="@color/card_button"
            tools:text="Ignore" />

        <Button
            android:id="@+id/card_button_end"
            style="@style/Base.TextAppearance.AppCompat.Widget.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/card_text"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:minWidth="0px"
            android:textColor="@color/card_button"
            tools:text="Activate" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
